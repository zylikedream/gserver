services:
  # ==================== 基础设施 ====================

  postgres:
    image: postgres:18
    container_name: gserver-postgres
    command:
      - -c
      - config_file=/etc/postgresql/postgresql.conf
      - -c
      - hba_file=/etc/postgresql/pg_hba.conf
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: {{ postgres.user }}
      POSTGRES_PASSWORD: "{{ postgres.password }}"
      POSTGRES_DB: {{ postgres.database }}
    volumes:
      - pgdata:/var/lib/postgresql
      - ./postgres/postgresql.conf:/etc/postgresql/postgresql.conf
      - ./postgres/pg_hba.conf:/etc/postgresql/pg_hba.conf
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: gserver-redis
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    command: redis-server --requirepass "{{ redis.password }}"
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "{{ redis.password }}", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped

  consul:
    image: consul:1.15
    container_name: gserver-consul
    command: ["agent", "-dev", "-client=0.0.0.0"]
    ports:
      - "8500:8500"
    volumes:
      - consul-data:/consul/data
    restart: unless-stopped

  # ==================== 可观测性 ====================

  prometheus:
    image: prom/prometheus:latest
    container_name: gserver-prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--enable-feature=exemplar-storage"
    ports:
      - "9092:9090"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus-data:/prometheus
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    container_name: gserver-grafana
    ports:
      - "3000:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning
      - ./grafana/dashboards:/etc/grafana/dashboards
      - grafana-data:/var/lib/grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - prometheus
      - tempo
    restart: unless-stopped

  tempo:
    image: grafana/tempo:latest
    container_name: gserver-tempo
    command: ["-config.file=/etc/tempo.yaml"]
    ports:
      - "4317:4317"
    volumes:
      - ./tempo/tempo.yaml:/etc/tempo.yaml
      - tempo-data:/var/tempo
    restart: unless-stopped

  loki:
    image: grafana/loki:3.4.2
    container_name: gserver-loki
    command: ["-config.file=/etc/loki/local-config.yaml"]
    ports:
      - "3100:3100"
    volumes:
      - ./loki.yaml:/etc/loki/local-config.yaml
      - loki-data:/loki
    restart: unless-stopped

  promtail:
    image: grafana/promtail:3.4.2
    container_name: gserver-promtail
    user: root
    command: ["-config.file=/etc/promtail/config.yml"]
    volumes:
      # compose 文件在 deploy/docker/,相对项目根 log/ 需两级:../../log(一级会指向不存在的 deploy/log)
      - ../../log:/var/log/gameserver
      - ./promtail.yaml:/etc/promtail/config.yml
    depends_on:
      - loki
    restart: unless-stopped

volumes:
  pgdata:
  redis-data:
  consul-data:
  prometheus-data:
  grafana-data:
  tempo-data:
  loki-data:
