[node]
    name = "gate"
    host = "{{ env.host | default('127.0.0.1') }}"
	apps = ["gate"]
[port]
	# Actor系统节点间通信端口（protoactor-go remoting）
	actor = {{ port.actor | default(25001) }}
[postgres]
	url = "postgresql://{{ postgres.user }}:{{ postgres.password | urlencode }}@{{ postgres.host }}:{{ postgres.port }}/{{ postgres.database }}?sslmode={{ postgres.sslmode }}"
[redis]
	addr = "{{ redis.host }}:{{ redis.port }}"
	password = "{{ redis.password }}"
	db = {{ redis.db }}
	dial_timeout = "5s"
[log]
	path = "{{ log.path }}"
	level = "{{ log.level }}"
	file = "{Y-m-d}.log"
	stStatus = {{ log.stStatus }}
[registery]
	type = "consul"
[registery.consul]
	address = "{{ consul.host }}:{{ consul.port }}"
	ttl = "10s"
	refresh_ttl = "10s"
[trace]
	endpoint = "{{ trace.host }}:{{ trace.port }}"

[token]
	algorithm = "{{ token.algorithm | default('hs256') }}"
	issuer = "{{ token.issuer | default('account-service') }}"
	expire_seconds = {{ token.expire_seconds | default(300) }}
	env = "{{ token.env | default(env.name) }}"
[token.hs256]
	secret = "{{ token.hs256.secret | default(token.secret | default('replace-me')) }}"
[token.ed25519]
	private_key = "{{ token.ed25519.private_key | default('') }}"
	public_key = "{{ token.ed25519.public_key | default('') }}"

[login_limit]
enabled = {{ login_limit.enabled | default(true) | string | lower }}
rate = {{ login_limit.rate | default(200.0) }}
burst = {{ login_limit.burst | default(400) }}
max_inflight = {{ login_limit.max_inflight | default(100) }}
queue_size = {{ login_limit.queue_size | default(500) }}
wait_timeout = "{{ login_limit.wait_timeout | default('3s') }}"

# 网络配置
[gxynet]
	peer = "tcp_server"
[peer.tcp_server]
	addr = ":{{ gate.tcp_port }}"
[processor]
	packet = "ltiv"
	codec = "protobuf"
[packet.ltiv]
	size_length = 2
	type_length = 1
	id_length = 2
	byte_order = "little"
	# 必须 ≤ 长度字段上限(2^(8*size_length)-1 = 65535), 否则检查不可达且 Encode 静默截断
	max_size = 65535

[metrics]
	addr = ":{{ metrics_gate.port }}"
