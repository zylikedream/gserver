[node]
    name = "gate"
    host = "{{ env.host | default('127.0.0.1') }}"
	apps = ["gate"]
[actor]
	port = 25001
[postgres]
	url = "postgresql://{{ postgres.user }}:{{ postgres.password | urlencode }}@{{ postgres.host }}:{{ postgres.port }}/{{ postgres.database }}?sslmode={{ postgres.sslmode }}"
[redis]
	addr = "{{ redis.host }}:{{ redis.port }}"
	password = "{{ redis.password }}"
	db = {{ redis.db }}
	dial_timeout = "5s"
[log]
	path = "{{ log.path }}"
	level = "{{ log.level }}"
	file = "{Y-m-d}.log"
	stStatus = {{ log.stStatus }}
[registery]
	type = "consul"
[registery.consul]
	address = "{{ consul.host }}:{{ consul.port }}"
	ttl = "10s"
	refresh_ttl = "10s"
[trace]
	endpoint = "{{ trace.host }}:{{ trace.port }}"

# 网络配置
[gxynet]
	peer = "tcp_server"
[peer.tcp_server]
	addr = ":{{ gate.tcp_port }}"
[processor]
	packet = "ltiv"
	codec = "protobuf"
[packet.ltiv]
	size_length = 2
	type_length = 1
	id_length = 2
	byte_order = "little"
	max_size = 3145728
