[node]
    name = "game"
    host = "{{ env.host | default('127.0.0.1') }}"
	apps = ["chat", "role", "friend", "guild"]
[port]
	actor = 25101
	chat = 25102
	role = 25103
	friend = 25104
	guild = 25105
[postgres]
	url = "postgresql://{{ postgres.user }}:{{ postgres.password | urlencode }}@{{ postgres.host }}:{{ postgres.port }}/{{ postgres.database }}?sslmode={{ postgres.sslmode }}"
[redis]
	addr = "{{ redis.host }}:{{ redis.port }}"
	password = "{{ redis.password }}"
	db = {{ redis.db }}
	dial_timeout = "5s"
[log]
	path = "{{ log.path }}"
	level = "{{ log.level }}"
	file = "{Y-m-d}.log"
	stStatus = {{ log.stStatus }}
[registery]
	type = "consul"
[registery.consul]
	address = "{{ consul.host }}:{{ consul.port }}"
	ttl = "10s"
	refresh_ttl = "10s"
[metrics]
	addr = ":{{ metrics.port }}"
[trace]
	endpoint = "{{ trace.host }}:{{ trace.port }}"
