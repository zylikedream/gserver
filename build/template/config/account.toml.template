[node]
    name = "account"
    host = "{{ env.host | default('127.0.0.1') }}"
	apps = ["account"]
[port]
	# Actor系统节点间通信端口（protoactor-go remoting）
	actor = {{ port.actor | default(25106) }}
	# 账号服务HTTP端口
	account = {{ port.account | default(18080) }}
[postgres]
	url = "postgresql://{{ postgres.user }}:{{ postgres.password | urlencode }}@{{ postgres.host }}:{{ postgres.port }}/{{ postgres.database }}?sslmode={{ postgres.sslmode }}"
[redis]
	addr = "{{ redis.host }}:{{ redis.port }}"
	password = "{{ redis.password }}"
	db = {{ redis.db }}
	dial_timeout = "5s"
[log]
	path = "{{ log.path }}"
	level = "{{ log.level }}"
	file = "{Y-m-d}.log"
	stStatus = {{ log.stStatus }}
[registery]
	type = "consul"
[registery.consul]
	address = "{{ consul.host }}:{{ consul.port }}"
	ttl = "10s"
	refresh_ttl = "10s"
[trace]
	endpoint = "{{ trace.host }}:{{ trace.port }}"
[metrics]
addr = ":{{ metrics_account.port | default(9096) }}"


[gate.public]
	host = "{{ gate.public_host | default(env.host | default('127.0.0.1')) }}"
	port = {{ gate.tcp_port }}

[version]
	min = "{{ version.min | default('1.0.0') }}"
	latest = "{{ version.latest | default(version.min | default('1.0.0')) }}"

[token]
	algorithm = "{{ token.algorithm | default('hs256') }}"
	issuer = "{{ token.issuer | default('account-service') }}"
	expire_seconds = {{ token.expire_seconds | default(300) }}
	env = "{{ token.env | default(env.name) }}"
[token.hs256]
	secret = "{{ token.hs256.secret | default(token.secret | default('replace-me')) }}"
[token.ed25519]
	private_key = "{{ token.ed25519.private_key | default('') }}"
	public_key = "{{ token.ed25519.public_key | default('') }}"
