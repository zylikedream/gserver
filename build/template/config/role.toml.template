[node]
    name = "role"
    host = "{{ env.host | default('127.0.0.1') }}"
	apps = ["role"]
[port]
	# Ergo Actor 节点间通信端口
	actor = {{ port.actor | default(25011) }}
[actor]
cookie = "{{ actor.cookie | default('gserver-ergo') }}"
network = "ergo"
shutdown_timeout = "15s"
[postgres]
	url = "postgresql://{{ postgres.user }}:{{ postgres.password | urlencode }}@{{ postgres.host }}:{{ postgres.port }}/{{ postgres.database }}?sslmode={{ postgres.sslmode }}"
[redis]
	addr = "{{ redis.host }}:{{ redis.port }}"
	password = "{{ redis.password }}"
	db = {{ redis.db }}
	dial_timeout = "5s"
[log]
	path = "{{ log.path }}"
	level = "{{ log.level }}"
	file = "{Y-m-d}.log"
	stStatus = {{ log.stStatus }}
[registery]
	type = "consul"
[registery.consul]
	address = "{{ consul.host }}:{{ consul.port }}"
	ttl = "10s"
	refresh_ttl = "10s"

[metrics]
	addr = ":{{ metrics_role.port }}"
[role_limit.default]
rate = {{ role_limit.default.rate | default(10.0) }}
burst = {{ role_limit.default.burst | default(20) }}
disabled = {{ role_limit.default.disabled | default(false) | string | lower }}
{% for module, limit in (role_limit.modules | default({})).items() %}
[role_limit.modules.{{ module }}]
{% if limit.rate is defined %}rate = {{ limit.rate }}{% endif %}
{% if limit.burst is defined %}burst = {{ limit.burst }}{% endif %}
{% if limit.disabled is defined %}disabled = {{ limit.disabled | string | lower }}{% endif %}
{% endfor %}
