[node]
    name = "guild"
    host = "{{ env.host | default('127.0.0.1') }}"
	apps = ["guild"]
[port]
	# Ergo Actor 节点间通信端口
	actor = {{ port.actor | default(25031) }}
[actor]
cookie = "{{ actor.cookie | default('gserver-ergo') }}"
network = "ergo"
shutdown_timeout = "15s"
	# 公会服务HTTP端口
	guild = {{ port.guild | default(25032) }}
[postgres]
	url = "postgresql://{{ postgres.user }}:{{ postgres.password | urlencode }}@{{ postgres.host }}:{{ postgres.port }}/{{ postgres.database }}?sslmode={{ postgres.sslmode }}"
[redis]
	addr = "{{ redis.host }}:{{ redis.port }}"
	password = "{{ redis.password }}"
	db = {{ redis.db }}
	dial_timeout = "5s"
[log]
	path = "{{ log.path }}"
	level = "{{ log.level }}"
	file = "{Y-m-d}.log"
	stStatus = {{ log.stStatus }}
[registery]
	type = "consul"
[registery.consul]
	address = "{{ consul.host }}:{{ consul.port }}"
	ttl = "10s"
	refresh_ttl = "10s"

[metrics]
	addr = ":{{ metrics_guild.port }}"
