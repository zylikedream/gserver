#!/bin/bash
# 重置数据库（清空 Redis 和 PostgreSQL）
# 由 gen_config.py 从 build/template/script/ 生成，不要直接修改

set -e

REDIS_HOST="{{ redis.host }}"
REDIS_PORT={{ redis.port }}
PG_HOST="{{ postgres.host }}"
PG_PORT={{ postgres.port }}
PG_USER="{{ postgres.user }}"
PG_DB="{{ postgres.database }}"

echo "=== Cleaning Redis ==="
redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" FLUSHDB
echo "Redis done."

echo ""
echo "=== Cleaning PostgreSQL ==="
PGPASSWORD="{{ postgres.password }}" psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" -d "$PG_DB" -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"
echo "PostgreSQL done."

echo ""
echo "All clean."
